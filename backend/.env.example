# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=pengaduan_warga
DB_PASSWORD=your_password_here
DB_PORT=5432

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRE=7d

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary Configuration (For image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ========================================
# Kios API (LLM Classification & Citizen Chatbot)
# OpenAI-compatible API Gateway (https://kiosapi.com/v1)
# ========================================
# Masukkan API Key dari dashboard Kios API (simpan HANYA di backend .env, jangan di commit)
KIOSAPI_API_KEY=your_kiosapi_key_here

# Base URL provider (default: https://kiosapi.com/v1)
KIOSAPI_BASE_URL=https://kiosapi.com/v1

# Model Free-Pro pilihan pilot sintetis; verifikasi ulang katalog/harga sebelum pemakaian
KIOSAPI_CLASSIFICATION_MODEL=minimax-m3.1-flash-free

# Model ID untuk Citizen AI Chatbot (FAQ & pelacakan status laporan)
KIOSAPI_CHAT_MODEL=minimax-m3.1-flash-free

# Kebijakan Gratis Saja (wajib true agar tidak ada fallback otomatis ke model berbayar)
KIOSAPI_FREE_ONLY=true

# Batas kuota request harian lokal untuk mencegah habisnya kuota tak terkendali
KIOSAPI_DAILY_REQUEST_LIMIT=200

# Timeout request ke provider (dalam milidetik)
KIOSAPI_REQUEST_TIMEOUT_MS=15000

# Batas token keluaran maksimum
KIOSAPI_CLASSIFICATION_MAX_TOKENS=500
KIOSAPI_CHAT_MAX_TOKENS=600
